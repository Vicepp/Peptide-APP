# Copy this file to ".env.local" and fill in the values from
# Firebase Console → Project settings → Your apps → Web app → SDK config.
# Leave them empty to run the app in DEMO MODE (data saved in the browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails that can open the Admin dashboard (see all users).
# Must match the list in firestore.rules.
VITE_ADMIN_EMAILS=admin@demo.com

# ---- Push notifications ----
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → "Generate key pair"
VITE_FIREBASE_VAPID_KEY=

# Server only (Vercel → Environment Variables; do NOT prefix with VITE_):
# Firebase Console → Project settings → Service accounts → "Generate new private key"
# Paste the whole JSON file contents as one line.
FIREBASE_SERVICE_ACCOUNT=
# Any long random string; protects the daily reminder job.
CRON_SECRET=

# Shown on the Support / Privacy / Terms pages
VITE_SUPPORT_EMAIL=support@pepvella.com
